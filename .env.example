# Nom affiché de ta boutique
SHOP_NAME=Plata Plata

# Adresse publique du site (à changer une fois en ligne, ex: https://maboutique.com)
BASE_URL=http://localhost:3000
PORT=3000

# Devise (eur, usd, cad, chf, mad, xof...)
CURRENCY=eur

# Pays de livraison acceptés (codes ISO séparés par des virgules)
SHIPPING_COUNTRIES=FR,BE,CH,LU,MA,SN,CI,CA

# Mot de passe de la page /admin.html (obligatoire pour gérer produits et commandes)
ADMIN_PASSWORD=change-moi

# Clés Stripe (https://dashboard.stripe.com/apikeys). Laisse vide = mode démo sans vrai paiement.
STRIPE_SECRET_KEY=
# Secret du webhook Stripe (endpoint: BASE_URL/webhook, événement checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
